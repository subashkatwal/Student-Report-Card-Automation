      "parameters": {
        "html": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n<meta charset=\"UTF-8\">\n<title>Grade Sheet</title>\n<style>\nbody { font-family: Arial, sans-serif; font-size: 12px; margin: 20px; }\n.center { text-align: center; }\n.header-box { margin: 10px 0; }\n.info-row { display: flex; justify-content: space-between; margin: 3px 0; }\n.info-row div { width: 48%; }\ntable { width: 100%; border-collapse: collapse; margin-top: 10px; }\ntable, th, td { border: 1px solid #000; }\nth, td { padding: 4px; text-align: center; vertical-align: middle; }\ntd.subject { text-align: left; padding-left: 6px; }\n.gpa-box { margin-top: 10px; font-weight: bold; text-align: center; }\n.result-row { display: flex; justify-content: space-between; margin-top: 8px; font-weight: bold; }\n.sign-row { display: flex; justify-content: space-between; margin-top: 30px; text-align: center; }\n.sign-row div { width: 30%; }\n.footer { margin-top: 20px; font-size: 11px; }\n.note { margin-top: 10px; font-size: 10px; }\n</style>\n</head>\n<body>\n\n<div class=\"center\">\n  <h3>GRADE SHEET</h3>\n</div>\n\n<div class=\"header-box\">\n  <div class=\"info-row\">\n    <div><strong>Name:</strong>{{ $json['Student Name '] }} </div>\n    <div><strong>Registration No:</strong>{{ $json['Registration Number '] }}  </div>\n  </div>\n  <div class=\"info-row\">\n    <div><strong>Date of Birth:</strong> {{ $json['Date of Birth '] }}  </div>\n    <div><strong>Symbol No:</strong>{{ $json['Symbol Number '] }} </div>\n  </div>\n  <div class=\"info-row\">\n    <div><strong>Grade:</strong> {{ $json.Grade }}</div>\n    <div><strong>Annual Examination:</strong> {{ $json['Annual Examination Year '] }} </div>\n  </div>\n  <div class=\"info-row\">\n    <div><strong>Conducted In:</strong> {{ $json['Conducted In (BS Year / AD Year) '] }} </div>\n  </div>\n</div>\n\n<table>\n  <thead>\n    <tr>\n      <th>S.N.</th>\n      <th>Subjects</th>\n      <th>Marks</th>\n    </tr>\n  </thead>\n  <tbody>\n    <tr><td>1</td><td class=\"subject\">Physics</td><td> {{ $json['Physics Marks '] }}    </td></tr>\n    <tr><td>2</td><td class=\"subject\">Chemistry</td><td> {{ $json['Chemistry Marks '] }}    </td></tr>\n    <tr><td>3</td><td class=\"subject\">Computer</td><td>{{ $json['Computer Marks '] }}     </td></tr>\n    <tr><td>4</td><td class=\"subject\">Nepali</td><td> {{ $json['Nepali Marks '] }}    </td></tr>\n    <tr><td>5</td><td class=\"subject\">English</td><td> {{ $json['English Marks '] }}     </td></tr>\n    <tr><td>6</td><td class=\"subject\">Social</td><td> {{ $json['Social Marks'] }}      </td></tr>\n  </tbody>\n</table>\n\n<div class=\"gpa-box\">\n  GRADE POINT AVERAGE (GPA): {{ $json.Grade }}\n</div>\n\n<div class=\"result-row\">\n  <!-- <div>Result:{{ $json['  Result (Pass/Fail/Distinction)   '] }}    </div> -->\n  <div>Rank:{{ $json['  Rank  '] }} </div>\n  <div>Attendance:{{ $json['  Attendance  '] }} <span> Days</span></div>\n</div>\n\n<div class=\"sign-row\">\n  <div>\n    _______________________<br>\n    Prepared By<br>\n    Exam Department\n  </div>\n  <div>\n    _______________________<br>\n    Checked By<br>\n    Ayushi Joshi\n  </div>\n  <div>\n    _______________________<br>\n    Head Teacher<br>\n    Shubham Dorje\n  </div>\n</div>\n\n<div class=\"footer\">\n  <div><strong>Date of Issue:</strong>{{ $json.issue_date }} </div>\n  <div class=\"note\">\n    <p><strong>Note:</strong></p>\n    <p>One credit hour equals 32 working hours.</p>\n    <p><strong>Internal (IN):</strong> Participation, practical / project work and terminal examinations.</p>\n    <p><strong>Theory (TH):</strong> Written external examination.</p>\n    <p>ABS = Absent, NG = Not Graded</p>\n  </div>\n</div>\n\n</body>\n</html>\n"
      },
